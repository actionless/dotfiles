#!/bin/bash
set -ueo pipefail


if [[ -z "${1:-}" || "$1" = "-h" ]] ; then
	echo "$0 FILEPATH [LIMIT]	- upload to 0x0.st"
	echo "$0 FILEPATH     	- upload to 0x0.st for 30 dys"
	echo "$0 FILEPATH LIMIT	- upload to 0x0.st for LIMIT hours"
	echo "$0 FILEPATH -k	- upload to keep.sh for 24 hours"
	echo "$0 FILEPATH -t	- upload to temp.sh for 3 days"
	exit 0
fi


FILEPATH="$(readlink -e "$1")"
shift

LIMIT="${1:-}"  # hours


if [[ "$LIMIT" = "-k" ]] ; then
	echo ":: Limit is 500 MB and 24 hours"
	curl \
		--upload-file "$FILEPATH" \
		https://free.keep.sh
elif [[ "$LIMIT" = "-t" ]] ; then
	echo ":: Limit is 512 MB and 3 days"
	set -x
	curl -F "file=@$FILEPATH" https://temp.sh/upload
elif [[ -n "$LIMIT" ]] ; then
	echo ":: Limit is 512 MB and ${LIMIT} hours"
	curl \
		-F'file=@'"$FILEPATH" \
		-Fexpires="$LIMIT" \
		https://0x0.st
else
	echo ":: Limit is 512 MB and 30+ days"
	curl \
		-F'file=@'"$FILEPATH" \
		https://0x0.st
fi

echo ":: DONE"
