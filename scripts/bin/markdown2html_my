#!/usr/bin/env bash
set -ueo pipefail

INPUT_FILE="$1"
BASENAME="$(basename "$INPUT_FILE" .md)"
OUTPUT_FILE="${2:-$BASENAME.html}"
TITLE="${3:-${BASENAME//_/ }}"

which md2html > /dev/null || (echo "/usr/bin/md2html is owned by md4c" && exit 1)
md2html \
	"$INPUT_FILE" \
	--output="$OUTPUT_FILE" \
	--html-title="$TITLE" \
	--full-html \
	--fstrikethrough \
	--ftables \
	--ftasklists \
	--funderline \
	--fwiki-links \
	--github
